---
import "@corvaui/tokens/css";
import "../styles.css";
import { routes } from "../content";

const { title = "Fieldnote House" } = Astro.props;
const base = import.meta.env.BASE_URL;
const basePath = base.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(basePath, "").replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="en" data-corva-theme="graphite-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Fieldnote House, a design-led retreat and hospitality showcase built with Astro and CorvaUI." />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <corva-app-bar heading="Fieldnote House">
        <nav class="primary-nav" slot="navigation" aria-label="Primary navigation">
          {routes.map((route) => (
            <a href={`${base}${route.href === "/" ? "" : route.href.slice(1)}`} aria-current={currentPath === route.href.replace(/\/$/, "") ? "page" : undefined}>{route.label}</a>
          ))}
        </nav>
        <corva-switch id="theme-switch" slot="actions" label="Dark mode"></corva-switch>
      </corva-app-bar>
      <details class="mobile-menu">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          {routes.map((route) => (
            <a href={`${base}${route.href === "/" ? "" : route.href.slice(1)}`} aria-current={currentPath === route.href.replace(/\/$/, "") ? "page" : undefined}>{route.label}</a>
          ))}
        </nav>
      </details>

      <main id="main-content" tabindex="-1"><slot /></main>

      <footer>
        <span>Fieldnote House, Catskill Foothills</span>
        <span>Astro + CorvaUI</span>
        <a href="https://www.corvaui.com/">Design system documentation</a>
      </footer>
    </div>

    <script>
      import { registerCorvaUI } from "@corvaui/astro";

      await registerCorvaUI();

      const root = document.documentElement;
      const control = document.querySelector("#theme-switch");
      const stored = localStorage.getItem("fieldnote-theme") || "graphite-light";

      const applyTheme = (theme: string) => {
        root.dataset.corvaTheme = theme;
        if (control) (control as HTMLInputElement).checked = theme === "graphite-dark";
      };

      applyTheme(stored);
      control?.addEventListener("corvaChange", (event) => {
        const checked = (event as CustomEvent<{ checked: boolean }>).detail.checked;
        const theme = checked ? "graphite-dark" : "graphite-light";
        localStorage.setItem("fieldnote-theme", theme);
        applyTheme(theme);
      });

      const prepareScrollableTables = () => {
        document.querySelectorAll<HTMLElement>(".corva-table-container").forEach((container) => {
          const caption = container.querySelector("caption")?.textContent?.trim() ?? "Data table";
          container.tabIndex = 0;
          container.setAttribute("role", "region");
          container.setAttribute("aria-label", `${caption}, horizontally scrollable`);
        });
      };

      Promise.all([
        customElements.whenDefined("corva-data-table"),
        customElements.whenDefined("corva-data-grid"),
      ]).then(() => requestAnimationFrame(() => requestAnimationFrame(prepareScrollableTables)));
    </script>
  </body>
</html>
