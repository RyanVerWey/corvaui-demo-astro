---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const breadcrumbs = JSON.stringify([{ label: "Rosehall", href: base }, { label: "Home" }]);
const demandData = JSON.stringify([
  { label: "Rooms", value: 82 },
  { label: "Events", value: 46 },
  { label: "Dining", value: 33 },
  { label: "Spa", value: 19 },
]);
const propertyColumns = JSON.stringify([
  { key: "property", header: "Property" },
  { key: "occupancy", header: "Occupancy" },
  { key: "adr", header: "ADR" },
  { key: "status", header: "Status" },
]);
const propertyRows = JSON.stringify([
  { property: "Rosehall Harbor", occupancy: "91%", adr: "$312", status: "Compression" },
  { property: "Rosehall Garden", occupancy: "76%", adr: "$248", status: "Group arrival" },
  { property: "Rosehall West", occupancy: "84%", adr: "$226", status: "Stable" },
]);
const guestSteps = JSON.stringify([
  { id: "book", label: "Book", description: "Room, rate, and preference captured." },
  { id: "prepare", label: "Prepare", description: "Arrival plan, dining, and event notes set." },
  { id: "delight", label: "Delight", description: "Service recovery and post-stay follow-up." },
]);
---

<BaseLayout title="Rosehall Hospitality | CorvaUI Astro Demo">
  <main class="app-main">
    <div class="app-page">
      <corva-breadcrumbs items={breadcrumbs} label="Page breadcrumb"></corva-breadcrumbs>

      <section class="hero-band" aria-labelledby="hero-title">
        <div class="hero-copy">
          <corva-stack gap="lg">
            <corva-badge tone="success">Hospitality revenue and guest operations</corva-badge>
            <corva-typography id="hero-title" as="h1" variant="display">
              Rosehall turns bookings, events, and guest care into one operating view.
            </corva-typography>
            <corva-typography variant="body">
              An Astro demo for boutique hotel groups that need rate decisions, VIP arrivals, banquet events, and service recovery to stay coordinated.
            </corva-typography>
            <div class="app-actions">
              <corva-button size="lg">Review pickup</corva-button>
              <corva-button variant="secondary" size="lg">Plan event week</corva-button>
            </div>
          </corva-stack>
        </div>

        <div class="signal-panel">
          <corva-card eyebrow="Portfolio" heading="Tonight at a glance">
            <div class="metric-row">
              <span><strong>84%</strong> occupancy</span>
              <span><strong>$268</strong> ADR</span>
              <span><strong>41</strong> VIP arrivals</span>
            </div>
            <corva-chart label="Demand mix" data={demandData}></corva-chart>
          </corva-card>
          <corva-alert tone="info" heading="Business story">
            Revenue, front office, events, and guest experience teams share the same operating picture before arrivals begin.
          </corva-alert>
        </div>
      </section>

      <section class="app-section" aria-labelledby="offer-title">
        <div class="app-section-header">
          <div>
            <corva-typography id="offer-title" as="h2" variant="title">Boutique hotel control room</corva-typography>
            <corva-typography variant="body">Built for properties where rate, event, and guest promises need the same source of truth.</corva-typography>
          </div>
          <corva-button-group label="Primary actions">
            <corva-button size="sm">Open arrivals</corva-button>
            <corva-button size="sm" variant="secondary">Review groups</corva-button>
          </corva-button-group>
        </div>

        <div class="feature-grid">
          <corva-card eyebrow="Revenue" heading="Pickup without spreadsheet drift">
            Segment demand, rate moves, and group blocks stay visible beside operational readiness.
          </corva-card>
          <corva-card eyebrow="Guest care" heading="VIP arrival memory">
            Preferences, incidents, dining notes, and recovery commitments follow the reservation.
          </corva-card>
          <corva-card eyebrow="Events" heading="Banquet execution">
            BEO changes, setup status, deposits, and staffing risk sit in the same event record.
          </corva-card>
        </div>
      </section>

      <section class="app-section" aria-labelledby="proof-title">
        <div class="app-two-column">
          <div>
            <div class="app-section-header compact">
              <div>
                <corva-typography id="proof-title" as="h2" variant="title">Property proof</corva-typography>
                <corva-typography variant="body">The demo exercises real tables, charts, forms, workflow, settings, and routed pages.</corva-typography>
              </div>
            </div>
            <corva-data-table caption="Portfolio watch" columns={propertyColumns} rows={propertyRows}></corva-data-table>
          </div>
          <corva-card eyebrow="Guest journey" heading="Reservation to recovery">
            <corva-stepper steps={guestSteps} active-index="1"></corva-stepper>
            <corva-divider label="Next route"></corva-divider>
            <div class="app-actions">
              <corva-link href={`${base}dashboard/`}>View revenue dashboard</corva-link>
              <corva-link href={`${base}work-orders/`}>Start event intake</corva-link>
            </div>
          </corva-card>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
