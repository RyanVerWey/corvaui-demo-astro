---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Fieldnote House | Stay, Gather, Make">
  <section class="home-hero" aria-labelledby="home-title">
    <figure class="hero-photo">
      <img src={`${base}images/fieldnote-living.jpg`} alt="Warm timber-and-stone living room opening onto a quiet woodland landscape" width="1800" height="1200" fetchpriority="high" />
    </figure>
    <div class="hero-copy">
      <corva-badge tone="info">Catskill foothills · 42.1948° N</corva-badge>
      <corva-typography id="home-title" as="h1" variant="display">Room to hear what comes next.</corva-typography>
      <corva-typography variant="body">A twelve-room house for slow weekends, focused retreats, and gatherings that need more than a venue.</corva-typography>
      <div class="hero-actions">
        <corva-link href={`${base}about/`} variant="button">Plan a stay</corva-link>
        <corva-link href={`${base}data-table/`} variant="standalone">View availability</corva-link>
      </div>
      <div class="arrival-note"><span>Next quiet arrival</span><strong>Sunday, 3:00 PM</strong></div>
    </div>
  </section>

  <section class="house-intro" aria-labelledby="house-title">
    <div class="section-number">01</div>
    <div>
      <corva-typography id="house-title" as="h2" variant="title">A house that makes space for the work.</corva-typography>
      <p>Fieldnote balances privacy and togetherness: small rooms, long tables, an open studio, and enough landscape to reset the conversation.</p>
    </div>
    <div class="house-facts"><span><strong>12</strong> rooms</span><span><strong>34</strong> acres</span><span><strong>01</strong> shared table</span></div>
  </section>

  <section class="experience-grid" aria-label="Fieldnote experiences">
    <article class="experience-copy"><small>Stay</small><h2>Wake slowly.</h2><p>Natural light, wool, oak, and a breakfast that follows the season.</p></article>
    <div class="experience-photos">
      <figure><img src={`${base}images/fieldnote-exterior.jpg`} alt="Black timber retreat opening from a broad lawn beneath mature trees" width="1400" height="933" loading="lazy" /></figure>
      <figure><img src={`${base}images/fieldnote-dining.jpg`} alt="Shared dining table beside tall windows overlooking the woods" width="1400" height="2100" loading="lazy" /></figure>
    </div>
    <article class="experience-copy dark"><small>Gather</small><h2>Bring the whole idea.</h2><p>Workshops, offsites, dinners, and celebrations with a producer who understands the shape of the day.</p></article>
  </section>

  <section class="fieldnote-proof" aria-labelledby="proof-title">
    <div>
      <corva-badge tone="success">This week at Fieldnote</corva-badge>
      <corva-typography id="proof-title" as="h2" variant="title">Hospitality with an operating memory.</corva-typography>
      <p>Every preference, room turn, event decision, and revenue signal lives in one readable system.</p>
    </div>
    <corva-card eyebrow="Guest readiness" heading="31 of 34 arrivals prepared"><corva-progress label="Arrival readiness" value="91"></corva-progress></corva-card>
  </section>

  <section class="closing-band">
    <div><small>Make a fieldnote</small><h2>Come with a question. Leave with a direction.</h2></div>
    <corva-link href={`${base}about/`} variant="button">Choose your stay</corva-link>
  </section>
</BaseLayout>
