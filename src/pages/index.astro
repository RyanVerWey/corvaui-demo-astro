---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const breadcrumbs = JSON.stringify([{ label: "CorvaUI", href: base }, { label: "Home" }]);

const serviceMix = JSON.stringify([
  { label: "HVAC", value: 37 },
  { label: "Electrical", value: 28 },
  { label: "Facilities", value: 22 },
  { label: "Specialty", value: 13 },
]);

const proofColumns = JSON.stringify([
  { key: "customer", header: "Customer" },
  { key: "region", header: "Region" },
  { key: "result", header: "Result" },
]);

const proofRows = JSON.stringify([
  { customer: "Cedarline Health", region: "Upper Midwest", result: "18% faster closeout" },
  { customer: "Prairie Foods", region: "Great Plains", result: "41 sites synchronized" },
  { customer: "Beacon Retail", region: "Ohio Valley", result: "2.7 hour response gain" },
]);

const pathSteps = JSON.stringify([
  { id: "triage", label: "Triage", description: "Route urgent requests by site, trade, and SLA." },
  { id: "dispatch", label: "Dispatch", description: "Assign crews with parts, notes, and contact history." },
  { id: "proof", label: "Proof", description: "Capture closeout photos, signatures, and invoice context." },
]);
---

<BaseLayout title="CorvaUI Operations | CorvaUI Astro Demo">
  <main class="app-main">
    <div class="app-page">
      <corva-breadcrumbs items={breadcrumbs} label="Page breadcrumb"></corva-breadcrumbs>

      <section class="hero-band" aria-labelledby="hero-title">
        <div class="hero-copy">
          <corva-stack gap="lg">
            <corva-badge tone="success">Rose-light assigned theme</corva-badge>
            <corva-typography id="hero-title" as="h1" variant="display">
              Premium field operations for regional service teams
            </corva-typography>
            <corva-typography variant="body">
              CorvaUI Field Services coordinates urgent work orders, customer records, technician schedules, and executive proof in one routed Astro demo.
            </corva-typography>
            <div class="app-actions">
              <corva-button size="lg">Plan a rollout</corva-button>
              <corva-button variant="secondary" size="lg">Review operations</corva-button>
            </div>
          </corva-stack>
        </div>

        <div class="signal-panel">
          <corva-card eyebrow="Live board" heading="Today at a glance">
            <div class="metric-row">
              <span><strong>126</strong> open orders</span>
              <span><strong>94%</strong> SLA protected</span>
              <span><strong>18</strong> crews active</span>
            </div>
            <corva-chart label="Service mix" data={serviceMix}></corva-chart>
          </corva-card>
          <corva-alert tone="info" heading="Business story">
            Dispatch, customer success, and finance share the same source of truth instead of chasing updates through calls and spreadsheets.
          </corva-alert>
        </div>
      </section>

      <section class="app-section" aria-labelledby="offer-title">
        <div class="app-section-header">
          <div>
            <corva-typography id="offer-title" as="h2" variant="title">CorvaUI operating system</corva-typography>
            <corva-typography variant="body">Built for service companies with dense regional coverage and demanding commercial accounts.</corva-typography>
          </div>
          <corva-button-group label="Primary actions">
            <corva-button size="sm">Create order</corva-button>
            <corva-button size="sm" variant="secondary">Open dashboard</corva-button>
          </corva-button-group>
        </div>

        <div class="feature-grid">
          <corva-card eyebrow="Command" heading="SLA-aware dispatch">
            Assign work by trade, proximity, required equipment, and customer tier.
          </corva-card>
          <corva-card eyebrow="Records" heading="Commercial account memory">
            Keep site contacts, asset history, warranties, and notes ready before the technician arrives.
          </corva-card>
          <corva-card eyebrow="Proof" heading="Closeout evidence">
            Package photos, signatures, timestamps, and billing context for faster approval.
          </corva-card>
        </div>
      </section>

      <section class="app-section" aria-labelledby="proof-title">
        <div class="app-two-column">
          <div>
            <div class="app-section-header compact">
              <div>
                <corva-typography id="proof-title" as="h2" variant="title">Customer proof</corva-typography>
                <corva-typography variant="body">The fake business site still exercises real data, tables, charts, forms, and routed pages.</corva-typography>
              </div>
            </div>
            <corva-data-table caption="Customer outcomes" columns={proofColumns} rows={proofRows}></corva-data-table>
          </div>
          <corva-card eyebrow="Workflow" heading="From call to closeout">
            <corva-stepper steps={pathSteps} active-index="1"></corva-stepper>
            <corva-divider label="Next route"></corva-divider>
            <div class="app-actions">
              <corva-link href={`${base}dashboard/`}>View dashboard</corva-link>
              <corva-link href={`${base}work-orders/`}>Start work order</corva-link>
            </div>
          </corva-card>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
