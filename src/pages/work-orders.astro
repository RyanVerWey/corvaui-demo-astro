---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const breadcrumbs = JSON.stringify([{ label: "Rosehall", href: base }, { label: "Event intake" }]);
const eventTypes = JSON.stringify([
  { label: "Corporate retreat", value: "retreat" },
  { label: "Wedding", value: "wedding" },
  { label: "Board dinner", value: "dinner" },
  { label: "Conference", value: "conference" },
]);
const priorityOptions = JSON.stringify([
  { label: "Standard", value: "standard", description: "Normal event manager review." },
  { label: "Premium", value: "premium", description: "Guest-experience review and revenue approval." },
  { label: "Executive", value: "executive", description: "GM visibility and daily readiness check." },
]);
const roomOptions = JSON.stringify(["Harbor Ballroom", "Garden Terrace", "Library Suite", "West Conservatory"]);
const eventSteps = JSON.stringify([
  { id: "request", label: "Request", description: "Capture event scope and guest profile." },
  { id: "plan", label: "Plan", description: "Set rooms, deposits, menus, and staffing." },
  { id: "execute", label: "Execute", description: "Lock BEO and service recovery plan." },
]);
---

<BaseLayout title="Event Intake | Rosehall Hospitality">
  <main class="app-main">
    <div class="app-page">
      <corva-breadcrumbs items={breadcrumbs} label="Page breadcrumb"></corva-breadcrumbs>

      <section class="page-intro" aria-labelledby="event-title">
        <div>
          <corva-badge tone="success">Event intake</corva-badge>
          <corva-typography id="event-title" as="h1" variant="display">Create a banquet-ready event.</corva-typography>
          <corva-typography variant="body">
            Sales, events, front office, culinary, and finance get the same event record before the guest promise becomes operational risk.
          </corva-typography>
        </div>
        <corva-card eyebrow="Progress" heading="Event detail">
          <corva-stepper steps={eventSteps} active-index="1"></corva-stepper>
        </corva-card>
      </section>

      <section class="app-two-column app-two-column-wide" aria-label="Event form">
        <corva-card eyebrow="Form" heading="Event request">
          <form class="app-form-grid">
            <corva-autocomplete label="Event space" options={roomOptions} value="Harbor Ballroom"></corva-autocomplete>
            <corva-text-field label="Planner" name="planner" value="Avery Stone"></corva-text-field>
            <corva-select label="Event type" name="event-type" options={eventTypes} value="retreat"></corva-select>
            <corva-date-picker label="Event date" name="event-date" value="2026-10-12"></corva-date-picker>
            <corva-time-picker label="Room ready time" name="room-ready" value="14:30"></corva-time-picker>
            <corva-number-field label="Expected guests" name="guests" min="1" max="900" value="184"></corva-number-field>
            <div class="form-wide">
              <corva-radio-group label="Service tier" name="tier" options={priorityOptions} value="premium"></corva-radio-group>
            </div>
            <div class="form-wide">
              <corva-textarea
                label="Event notes"
                name="notes"
                rows="5"
                value="Two-day executive retreat with welcome reception, morning keynote, and private dinner. Gluten-free menu count still pending."
              ></corva-textarea>
            </div>
            <corva-select
              label="Deposit status"
              name="deposit"
              options='[{"label":"Paid","value":"paid"},{"label":"Due","value":"due"},{"label":"Variance review","value":"variance"}]'
              value="variance"
            ></corva-select>
            <corva-text-field label="BEO attachment" name="beo" type="file" hint="Attach current banquet event order."></corva-text-field>
            <div class="form-wide">
              <corva-checkbox label="Notify culinary and front office" description="Send event summary after save." checked></corva-checkbox>
            </div>
            <div class="form-wide app-actions">
              <corva-button type="submit">Save event</corva-button>
              <corva-button type="reset" variant="secondary">Clear draft</corva-button>
            </div>
          </form>
        </corva-card>

        <div class="app-card-stack">
          <corva-alert tone="info" heading="Validation smoke">
            File, date, time, radio, select, textarea, and checkbox controls stay in one responsive Astro form.
          </corva-alert>
          <corva-card eyebrow="Readiness" heading="Operational notes">
            <div class="record-list">
              <span><strong>Rooms</strong> Harbor Ballroom plus Library Suite hold space.</span>
              <span><strong>Culinary</strong> Menu count variance is the current blocker.</span>
              <span><strong>Finance</strong> Deposit variance requires review before final BEO lock.</span>
            </div>
          </corva-card>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
