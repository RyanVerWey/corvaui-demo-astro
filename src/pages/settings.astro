---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const breadcrumbs = JSON.stringify([{ label: "Rosehall", href: base }, { label: "Settings" }]);
const localeOptions = JSON.stringify([
  { label: "English, United States", value: "en-US" },
  { label: "French", value: "fr" },
  { label: "Japanese", value: "ja" },
]);
const timezoneOptions = JSON.stringify([
  { label: "Eastern", value: "America/New_York" },
  { label: "Central", value: "America/Chicago" },
  { label: "Mountain", value: "America/Denver" },
  { label: "Pacific", value: "America/Los_Angeles" },
]);
const themeOptions = JSON.stringify([
  { label: "Rose light", value: "rose-light", description: "Default assigned theme for the demo." },
  { label: "Rose dark", value: "rose-dark", description: "Readable dark counterpart for smoke testing." },
]);
const tabs = JSON.stringify([
  { id: "profile", label: "Profile" },
  { id: "property", label: "Property" },
  { id: "alerts", label: "Alerts" },
]);
---

<BaseLayout title="Settings | Rosehall Hospitality">
  <main class="app-main">
    <div class="app-page">
      <corva-breadcrumbs items={breadcrumbs} label="Page breadcrumb"></corva-breadcrumbs>

      <section class="page-intro" aria-labelledby="settings-title">
        <div>
          <corva-badge tone="info">Account</corva-badge>
          <corva-typography id="settings-title" as="h1" variant="display">Settings for hospitality teams</corva-typography>
          <corva-typography variant="body">
            Preferences, locale, notification rules, and theme controls demonstrate a compact settings surface for revenue and guest operations.
          </corva-typography>
        </div>
        <corva-tabs label="Settings sections" items={tabs} active-id="property"></corva-tabs>
      </section>

      <section class="app-two-column app-two-column-wide" aria-label="Settings forms">
        <corva-card eyebrow="Profile" heading="Revenue operator">
          <form class="app-form-grid">
            <corva-text-field label="Name" name="name" value="Mira Chen"></corva-text-field>
            <corva-text-field label="Email" name="email" type="email" value="mira@rosehall.example"></corva-text-field>
            <corva-select label="Locale" name="locale" options={localeOptions} value="en-US"></corva-select>
            <corva-select label="Time zone" name="timezone" options={timezoneOptions} value="America/New_York"></corva-select>
            <div class="form-wide">
              <corva-radio-group label="Theme preference" name="theme" options={themeOptions} value="rose-light"></corva-radio-group>
            </div>
            <div class="form-wide app-actions">
              <corva-button type="submit">Save settings</corva-button>
              <corva-button type="button" variant="secondary">Reset</corva-button>
            </div>
          </form>
        </corva-card>

        <div class="app-card-stack">
          <corva-card eyebrow="Property" heading="Operating defaults">
            <div class="record-list">
              <corva-switch label="Auto-flag VIP preference gaps" checked></corva-switch>
              <corva-switch label="Require BEO approval before event lock" checked></corva-switch>
              <corva-switch label="Hold rate changes when group pickup is stale"></corva-switch>
            </div>
          </corva-card>
          <corva-card eyebrow="Alerts" heading="Notification rules">
            <div class="record-list">
              <corva-checkbox label="Arrival readiness email" description="Send when VIP preparation falls below target." checked></corva-checkbox>
              <corva-checkbox label="Event variance digest" description="Summarize deposits, menu counts, and room setup changes." checked></corva-checkbox>
              <corva-checkbox label="Rate compression warning" description="Notify revenue leads before sellout windows."></corva-checkbox>
            </div>
          </corva-card>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
