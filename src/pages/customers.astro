---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const breadcrumbs = JSON.stringify([{ label: "Rosehall", href: base }, { label: "Guests" }]);
const guestColumns = JSON.stringify([
  { key: "guest", header: "Guest" },
  { key: "segment", header: "Segment" },
  { key: "owner", header: "Owner" },
  { key: "value", header: "Stay value" },
]);
const guestRows = JSON.stringify([
  { guest: "Nora Vale", segment: "VIP leisure", owner: "Mira Chen", value: "$8.4k" },
  { guest: "Cedar Group", segment: "Corporate group", owner: "Eli Hart", value: "$42k" },
  { guest: "Kento Mori", segment: "Suite repeat", owner: "Samira Wells", value: "$12.1k" },
  { guest: "Amina Hart", segment: "Recovery", owner: "Mira Chen", value: "$2.8k" },
]);
const boardColumns = JSON.stringify([
  {
    id: "arriving",
    title: "Arriving",
    items: [
      { id: "g1", title: "Nora Vale", meta: "VIP amenity" },
      { id: "g2", title: "Cedar Group", meta: "Room block" },
    ],
  },
  {
    id: "inhouse",
    title: "In house",
    items: [
      { id: "g3", title: "Amina Hart", meta: "Recovery note" },
      { id: "g4", title: "Kento Mori", meta: "Suite upsell" },
    ],
  },
  {
    id: "followup",
    title: "Follow-up",
    items: [
      { id: "g5", title: "Spa credit email", meta: "Tomorrow" },
      { id: "g6", title: "Group rebook call", meta: "Friday" },
    ],
  },
]);
const preferenceTree = JSON.stringify([
  {
    id: "nora",
    label: "Nora Vale",
    children: [
      { id: "room", label: "High floor, harbor view" },
      { id: "dining", label: "Late dinner, quiet table" },
      { id: "amenity", label: "Sparkling water, citrus" },
    ],
  },
  {
    id: "cedar",
    label: "Cedar Group",
    children: [
      { id: "block", label: "18 rooms" },
      { id: "meeting", label: "Boardroom breakfast" },
    ],
  },
]);
---

<BaseLayout title="Guest Records | Rosehall Hospitality">
  <main class="app-main">
    <div class="app-page">
      <corva-breadcrumbs items={breadcrumbs} label="Page breadcrumb"></corva-breadcrumbs>

      <section class="page-intro" aria-labelledby="guests-title">
        <div>
          <corva-badge tone="info">Guest records</corva-badge>
          <corva-typography id="guests-title" as="h1" variant="display">Guests, groups, and preference memory.</corva-typography>
          <corva-typography variant="body">
            Front office and guest experience teams can scan arrival value, loyalty context, preferences, and recovery work before check-in.
          </corva-typography>
        </div>
        <corva-search-form label="Search guest records" placeholder="Guest, group, property, owner"></corva-search-form>
      </section>

      <section class="app-two-column app-two-column-wide" aria-label="Guest board and detail">
        <corva-card eyebrow="Experience board" heading="Guest movement">
          <corva-workflow-board columns={boardColumns}></corva-workflow-board>
        </corva-card>

        <corva-card eyebrow="Selected guest" heading="Nora Vale">
          <div class="record-list">
            <span><strong>Segment</strong> VIP leisure, third Rosehall stay</span>
            <span><strong>Preference</strong> Harbor view, late dinner, citrus amenity</span>
            <span><strong>Open promise</strong> Spa credit carried from prior recovery note</span>
          </div>
          <corva-divider label="Readiness"></corva-divider>
          <corva-progress label="Arrival preparation" value="92"></corva-progress>
          <corva-rating label="Loyalty strength" value="5"></corva-rating>
        </corva-card>
      </section>

      <section class="app-two-column" aria-label="Guest records">
        <corva-data-grid caption="Guest value grid" columns={guestColumns} rows={guestRows}></corva-data-grid>
        <corva-card eyebrow="Preferences" heading="Guest memory tree">
          <corva-tree-view label="Guest preference tree" items={preferenceTree}></corva-tree-view>
        </corva-card>
      </section>
    </div>
  </main>
</BaseLayout>
