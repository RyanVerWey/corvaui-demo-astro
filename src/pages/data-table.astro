---
import BaseLayout from "../layouts/BaseLayout.astro";
import { bookingColumns, bookingRows } from "../content";
---
<BaseLayout title="Bookings | Fieldnote House">
  <header class="page-hero data-hero">
    <div>
      <corva-badge tone="success">September arrival book</corva-badge>
      <corva-typography as="h1" variant="display">Bookings, with the human details intact.</corva-typography>
      <corva-typography variant="body">Revenue and readiness share the same record, so the team can scan what is booked and understand what each arrival needs.</corva-typography>
    </div>
    <div class="data-summary" aria-label="Booking summary"><span><strong>88%</strong> occupancy</span><span><strong>$402</strong> average rate</span><span><strong>91%</strong> prepared</span></div>
  </header>
  <section class="grid-shell" aria-label="Fieldnote booking records">
    <corva-data-grid id="booking-grid" caption="September bookings" sortable filterable pageable page-size="6"></corva-data-grid>
  </section>
  <corva-alert tone="info" heading="DataGrid proof">Astro renders the page statically, then assigns typed rows and columns as element properties. CorvaUI owns filtering, sorting, paging, and theme states.</corva-alert>
  <script define:vars={{ bookingColumns, bookingRows }}>
    customElements.whenDefined("corva-data-grid").then(() => {
      Object.assign(document.querySelector("#booking-grid"), { columns: bookingColumns, rows: bookingRows });
    });
  </script>
</BaseLayout>
