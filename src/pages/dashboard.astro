---
import BaseLayout from "../layouts/BaseLayout.astro";
import { revenueData, occupancyData, reportColumns, reportRows } from "../content";
---
<BaseLayout title="Reports | Fieldnote House">
  <header class="page-hero reports-hero">
    <div>
      <corva-badge tone="info">September outlook</corva-badge>
      <corva-typography as="h1" variant="display">A report for protecting the experience.</corva-typography>
      <corva-typography variant="body">Demand, rate, guest readiness, and event commitments stay close enough to support calm operating decisions.</corva-typography>
    </div>
    <corva-tabs label="Report period" active-id="month" items='[{"id":"week","label":"Week"},{"id":"month","label":"Month"},{"id":"quarter","label":"Quarter"}]'></corva-tabs>
  </header>

  <section class="metric-ribbon" aria-label="Hospitality metrics">
    <article><span>Occupancy</span><strong>88%</strong><small>+6 pts vs. plan</small></article>
    <article><span>Average rate</span><strong>$402</strong><small>+$28 year over year</small></article>
    <article><span>Retreat revenue</span><strong>$98K</strong><small>September on books</small></article>
    <article><span>Arrival ready</span><strong>91%</strong><small>31 of 34 arrivals</small></article>
  </section>

  <section class="chart-layout">
    <corva-paper><corva-chart id="revenue-chart" label="Revenue mix"></corva-chart></corva-paper>
    <corva-paper><corva-chart id="occupancy-chart" label="Forward occupancy"></corva-chart></corva-paper>
  </section>

  <section class="report-layout" aria-labelledby="outlook-title">
    <div>
      <div class="section-heading compact"><corva-typography id="outlook-title" as="h2" variant="title">Commercial outlook</corva-typography><p>Current pace, rate, and booked revenue.</p></div>
      <corva-data-table id="report-table" caption="Fieldnote commercial outlook"></corva-data-table>
    </div>
    <div class="report-aside">
      <figure class="report-photo"><img src="/images/fieldnote-dining.jpg" alt="Fieldnote dining room overlooking the surrounding woods" width="1400" height="2100" loading="lazy" /></figure>
      <corva-card eyebrow="Recommended action" heading="Hold October weekends">Current pace supports a measured rate lift without compromising direct-booking conversion.</corva-card>
      <corva-progress label="Q4 revenue target" value="74"></corva-progress>
      <corva-alert tone="warning" heading="One production decision">Morrow Studio rooming list is due before tomorrow's kitchen order.</corva-alert>
    </div>
  </section>

  <script define:vars={{ revenueData, occupancyData, reportColumns, reportRows }}>
    Promise.all([
      customElements.whenDefined("corva-chart"),
      customElements.whenDefined("corva-data-table"),
    ]).then(() => {
      Object.assign(document.querySelector("#revenue-chart"), { data: revenueData });
      Object.assign(document.querySelector("#occupancy-chart"), { data: occupancyData });
      Object.assign(document.querySelector("#report-table"), { columns: reportColumns, rows: reportRows });
    });
  </script>
</BaseLayout>
