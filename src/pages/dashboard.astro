---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const breadcrumbs = JSON.stringify([
  { label: "CorvaUI", href: base },
  { label: "Dashboard" },
]);

const chartData = JSON.stringify([
  { label: "On site", value: 32 },
  { label: "Queued", value: 21 },
  { label: "Parts hold", value: 9 },
  { label: "Closed", value: 64 },
]);

const backlogData = JSON.stringify([
  { label: "Critical", value: 8 },
  { label: "High", value: 19 },
  { label: "Normal", value: 47 },
  { label: "Low", value: 12 },
]);

const queueColumns = JSON.stringify([
  { key: "ticket", header: "Ticket" },
  { key: "site", header: "Site" },
  { key: "owner", header: "Owner" },
  { key: "sla", header: "SLA" },
]);

const queueRows = JSON.stringify([
  { ticket: "WO-1842", site: "Beacon Retail 14", owner: "Mara Chen", sla: "42 min" },
  { ticket: "WO-1843", site: "Cedarline West", owner: "Owen Patel", sla: "1 hr 15 min" },
  { ticket: "WO-1844", site: "Prairie Foods Dock 3", owner: "Inez Cruz", sla: "2 hr 05 min" },
  { ticket: "WO-1845", site: "Marsh Labs", owner: "Unassigned", sla: "3 hr 20 min" },
]);

const boardColumns = JSON.stringify([
  {
    id: "new",
    title: "New",
    items: [
      { id: "n1", title: "Leak report, suite 210", meta: "HVAC" },
      { id: "n2", title: "Generator test failed", meta: "Electrical" },
    ],
  },
  {
    id: "routed",
    title: "Routed",
    items: [
      { id: "r1", title: "Dock sensor replacement", meta: "Team 4" },
      { id: "r2", title: "Rooftop unit inspection", meta: "Team 7" },
    ],
  },
  {
    id: "closed",
    title: "Closed",
    items: [
      { id: "c1", title: "Lobby access reader", meta: "Signed" },
      { id: "c2", title: "Freezer alarm calibration", meta: "Billed" },
    ],
  },
]);
---

<BaseLayout title="Metrics Dashboard | CorvaUI Field Services">
  <main class="app-main">
    <div class="app-page">
      <corva-breadcrumbs items={breadcrumbs} label="Page breadcrumb"></corva-breadcrumbs>

      <section class="page-intro" aria-labelledby="dashboard-title">
        <div>
          <corva-badge tone="info">Operations desk</corva-badge>
          <corva-typography id="dashboard-title" as="h1" variant="display">Metrics dashboard</corva-typography>
          <corva-typography variant="body">
            CorvaUI dispatch leads use this morning view to balance service level risk, crew utilization, and closeout readiness.
          </corva-typography>
        </div>
        <corva-toolbar label="Dashboard tools">
          <corva-button size="sm">Refresh</corva-button>
          <corva-button size="sm" variant="secondary">Export</corva-button>
        </corva-toolbar>
      </section>

      <section class="metric-strip" aria-label="Daily metrics">
        <corva-card eyebrow="SLA" heading="94% protected">
          <corva-progress label="SLA coverage" value="94"></corva-progress>
        </corva-card>
        <corva-card eyebrow="Crews" heading="18 active">
          <corva-progress label="Crew utilization" value="81"></corva-progress>
        </corva-card>
        <corva-card eyebrow="Revenue" heading="$82.4k ready">
          <corva-progress label="Billable closeout" value="68"></corva-progress>
        </corva-card>
      </section>

      <section class="app-two-column app-two-column-wide" aria-label="Charts and status">
        <corva-card eyebrow="Queue" heading="Work order state">
          <corva-chart label="Current ticket mix" data={chartData}></corva-chart>
        </corva-card>
        <corva-card eyebrow="Risk" heading="Backlog pressure">
          <corva-chart label="Backlog by priority" data={backlogData}></corva-chart>
        </corva-card>
      </section>

      <section class="app-section" aria-labelledby="workflow-title">
        <div class="app-section-header">
          <div>
            <corva-typography id="workflow-title" as="h2" variant="title">Dispatch workflow</corva-typography>
            <corva-typography variant="body">Status widgets and tables share the same rose token surface.</corva-typography>
          </div>
          <corva-tabs
            label="Dashboard window"
            items='[{"id":"today","label":"Today"},{"id":"week","label":"Week"},{"id":"month","label":"Month"}]'
            active-id="today"
          ></corva-tabs>
        </div>
        <div class="app-two-column app-two-column-wide">
          <corva-card eyebrow="Board" heading="Ticket movement">
            <corva-workflow-board columns={boardColumns}></corva-workflow-board>
          </corva-card>
          <div class="app-card-stack">
            <corva-data-table caption="SLA queue" columns={queueColumns} rows={queueRows}></corva-data-table>
            <corva-alert tone="warning" heading="Watch list">
              Three sites need part confirmation before noon to protect premium account commitments.
            </corva-alert>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
