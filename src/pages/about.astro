---
import BaseLayout from "../layouts/BaseLayout.astro";
import { stayColumns, stayRows } from "../content";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Stay + Gather | Fieldnote House">
  <header class="page-hero">
    <div>
      <corva-badge tone="info">Ways to be here</corva-badge>
      <corva-typography as="h1" variant="display">A room, a house, or the whole horizon.</corva-typography>
      <corva-typography variant="body">Choose the amount of privacy, hosting, and production your stay needs. The house remains attentive at every scale.</corva-typography>
    </div>
    <corva-card eyebrow="Fieldnote standard" heading="Breakfast, studio, landscape">Every stay includes the shared table, trail access, and a host who knows why you came.</corva-card>
  </header>

  <section class="table-section" aria-labelledby="compare-title">
    <div class="section-heading compact">
      <corva-typography id="compare-title" as="h2" variant="title">Stay comparison</corva-typography>
      <p>Three formats, one house rhythm.</p>
    </div>
    <corva-data-table id="stay-table" caption="Fieldnote stay comparison"></corva-data-table>
  </section>

  <section class="stay-notes" aria-label="Stay formats">
    <article><span>Field Room</span><h2>Private, with a table nearby.</h2><p>For a solo reset or a weekend for two. Join the house when you want to.</p></article>
    <article><span>House Stay</span><h2>Your people, held together.</h2><p>Eight guests, a private dining rhythm, and enough room for conversation to change pace.</p></article>
    <article><span>Full Retreat</span><h2>The whole place in service.</h2><p>Rooms, studio, table, landscape, and a producer shaping every transition.</p></article>
  </section>

  <section class="principle-band">
    <div><small>Hosting principle 03</small><h2>Structure should disappear once everyone arrives.</h2></div>
    <corva-link href={`${base}data-table/`} variant="button">Check bookings</corva-link>
  </section>

  <script define:vars={{ stayColumns, stayRows }}>
    customElements.whenDefined("corva-data-table").then(() => {
      Object.assign(document.querySelector("#stay-table"), { columns: stayColumns, rows: stayRows });
    });
  </script>
</BaseLayout>
